# OpenAI-compatible Hy3 endpoint. Never commit a real key.
HY3_BASE_URL=https://tokenhub.tencentmaas.com/v1
HY3_API_KEY=EMPTY
HY3_MODEL=hy3

# Enable only when the selected endpoint supports Hy3 reasoning_effort.
HY3_ENABLE_REASONING_EFFORT=false
HY3_REASONING_EFFORT=high

# Repository ingestion guardrails.
REPOSCOPE_MAX_REPO_MB=80
REPOSCOPE_CLONE_TIMEOUT_SECONDS=90
REPOSCOPE_ALLOWED_GIT_HOSTS=github.com

